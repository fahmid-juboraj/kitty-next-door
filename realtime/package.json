{
  "name": "kitty-next-door-live",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "node extension/build.mjs",
    "test": "node tests/run-unit.mjs",
    "test:live": "node --test --test-concurrency=1 tests/live.test.mjs",
    "test:bg": "node extension/build.mjs && node --test --test-concurrency=1 tests/background.test.mjs",
    "test:page": "node extension/build.mjs && cd .. && node scripts/run.mjs realtime/tests/content-harness.cjs && node scripts/run.mjs realtime/tests/popup-harness.cjs",
    "server": "npm --prefix server run dev",
    "server:test": "npm --prefix server run dev -- --var STAY_SECONDS:4"
  }
}
