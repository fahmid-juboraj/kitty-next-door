{
  "name": "kitty-next-door",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "A cat that lives on your desktop and keeps you company.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/run.mjs",
    "gallery": "npm run build && node scripts/run.mjs --gallery",
    "typecheck": "tsc --noEmit",
    "selftest": "npm run build && node scripts/run.mjs --selftest",
    "dist:win": "npm run build && electron-builder --win",
    "build:ext": "node scripts/build-ext.mjs",
    "test": "esbuild tests/visit.test.ts --bundle --platform=node --format=esm --outfile=dist-test/visit.test.mjs --log-level=warning && node --test dist-test/visit.test.mjs",
    "test:ext": "npm run build:ext && node scripts/run.mjs scripts/ext-harness.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.fahmid-juboraj.kittynextdoor",
    "productName": "Kitty Next Door",
    "directories": {
      "output": "release"
    },
    "files": [
      "LICENSE",
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Kitty-Next-Door-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true,
      "uninstallDisplayName": "Kitty Next Door",
      "shortcutName": "Kitty Next Door",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Kitty-Next-Door-Portable-${version}.${ext}"
    }
  },
  "author": "MD. FAHMID-UL-ALAM JUBORAJ"
}
